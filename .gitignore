# vscode / claude
.vscode
.claude

# Internal product notes — keep on this machine, do not push
docs/PRD.md

# Private marketing site — keep the public repository focused on the plugin
# (anchored: on case-insensitive macOS an unanchored "Media/" would also
# swallow src/media/)
/promo/

# Generated local visual outputs
/output/

# Local manual-test media
/Media/

# Intellij
*.iml
.idea

# npm
node_modules

# Downloaded and generated dictionary data (recreated with tools/*.mjs)
data/

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Browser extension build output (rebuild with npm run extension:build)
extension/dist/

# Local grey-release zips
dist/

# Exclude sourcemaps
*.map

# obsidian
data.json

# Marker for the Hot Reload plugin during local development
.hotreload

# Throwaway CDP probes used to verify behaviour in a live Obsidian window
dev-probe/

# Exclude macOS Finder (System Explorer) View States
.DS_Store
