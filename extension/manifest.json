{
	"manifest_version": 3,
	"name": "Glean YouTube Capture",
	"version": "0.0.1",
	"description": "Capture YouTube captions and sync them to the Glean Obsidian plugin.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Glean",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"permissions": ["storage", "activeTab", "scripting"],
	"host_permissions": [
		"https://www.youtube.com/*",
		"https://youtube.com/*",
		"https://m.youtube.com/*",
		"https://youtu.be/*",
		"http://127.0.0.1/*",
		"http://localhost/*"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"web_accessible_resources": [
		{
			"resources": ["page-bridge.js", "icons/icon-16.png", "icons/icon-32.png", "icons/icon-48.png"],
			"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"https://www.youtube.com/*",
				"https://youtube.com/*",
				"https://m.youtube.com/*"
			],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_idle"
		}
	]
}
